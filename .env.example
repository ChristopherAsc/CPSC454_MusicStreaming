# Use true for a local SQLite development database.
# Use false when running on EC2 with the shared RDS database.
USE_SQLITE=true

DB_NAME=radio
DB_USER=replace_with_database_username
DB_PASSWORD=replace_with_database_password
DB_HOST=replace_with_rds_endpoint
DB_PORT=3306

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
